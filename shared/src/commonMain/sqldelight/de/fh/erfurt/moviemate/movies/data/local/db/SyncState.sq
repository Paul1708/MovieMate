CREATE TABLE syncMetadata (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE syncTombstone (
    entityType TEXT NOT NULL,
    entityId TEXT NOT NULL,
    deletedAtEpochMillis INTEGER NOT NULL,
    PRIMARY KEY (entityType, entityId)
);

selectMetadata:
SELECT value
FROM syncMetadata
WHERE key = ?;

upsertMetadata:
INSERT OR REPLACE INTO syncMetadata(key, value)
VALUES (?, ?);

selectTombstone:
SELECT *
FROM syncTombstone
WHERE entityType = ? AND entityId = ?;

selectTombstonesByType:
SELECT *
FROM syncTombstone
WHERE entityType = ?
ORDER BY entityId ASC;

upsertTombstone:
INSERT OR REPLACE INTO syncTombstone(entityType, entityId, deletedAtEpochMillis)
VALUES (?, ?, ?);

deleteTombstone:
DELETE FROM syncTombstone
WHERE entityType = ? AND entityId = ?;
