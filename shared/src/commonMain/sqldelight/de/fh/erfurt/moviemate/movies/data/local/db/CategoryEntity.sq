CREATE TABLE categoryEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    updatedAtEpochMillis INTEGER NOT NULL,
        version INTEGER
);

selectAll:
SELECT *
FROM categoryEntity
ORDER BY name ASC;

selectById:
SELECT *
FROM categoryEntity
WHERE id = ?;

insertCategory:
INSERT INTO categoryEntity(id, name, updatedAtEpochMillis, version)
VALUES (?, ?, ?, ?);

updateCategory:
UPDATE categoryEntity
SET
    name = ?,
    updatedAtEpochMillis = ?,
    version = ?
WHERE id = ?;

deleteCategory:
DELETE FROM categoryEntity
WHERE id = ?;
