CREATE TABLE MovieEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    posterUri TEXT NOT NULL,
    publishingYear INTEGER NOT NULL,
    runtime INTEGER NOT NULL,
    rating INTEGER NOT NULL,
    isWatched BOOL NOT NULL,
    categoryId TEXT NOT NULL,
    description TEXT NOT NULL,
    creationTimeEpochMillis INTEGER NOT NULL,
    updateTimeEpochMillis INTEGER NOT NULL
);

selectAll:
SELECT *
FROM MovieEntity
ORDER BY updateTimeEpochMillis DESC;

insertMovie:
INSERT INTO MovieEntity (id, title, posterUri, publishingYear, runtime, rating, isWatched, categoryId, description, creationTimeEpochMillis, updateTimeEpochMillis)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateMovie:
UPDATE MovieEntity
SET title = ?, posterUri = ?, publishingYear = ?, runtime = ?, rating = ?, isWatched = ?, categoryId = ?, description = ?, updateTimeEpochMillis = ?
WHERE id = ?;

updateWatchStatus:
UPDATE MovieEntity
SET isWatched = ?, updateTimeEpochMillis = ?
WHERE id = ?;

updateRating:
UPDATE MovieEntity
SET rating = ?, updateTimeEpochMillis = ?
WHERE id = ?;

deleteMovie:
DELETE FROM MovieEntity
WHERE id = ?;

deleteAllMovies:
DELETE FROM MovieEntity;